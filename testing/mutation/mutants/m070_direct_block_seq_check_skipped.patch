mutant: m070_direct_block_seq_check_skipped
target: internal/catalog/scripts.go
failure-mode: |
  CommitBlocks, the direct-mode block transaction, no longer locks and
  checks its namespace's seq key against the group's first seq (design
  §10.6). A leader whose in-memory seq diverged from the catalog would
  commit a block that overlaps or skips the committed range, and the script
  overwrites the seq key anyway.
expected-detection: |
  Correct leaders never diverge: every direct-mode session reloads its seq
  from the catalog, including after a block commit that applied but
  reported failure. So the layer 3 oracle's direct-mode kills have no path
  that reaches this check. TestScripts_DirectSeqMismatch commits a block at
  the wrong first seq and requires SourceSeq corruption.
expected-tier: disagg
tiers: disagg

diff --git a/internal/catalog/scripts.go b/internal/catalog/scripts.go
--- a/internal/catalog/scripts.go
+++ b/internal/catalog/scripts.go
@@ -504,9 +504,6 @@
 	out := make([]BlockCommit, len(bs))
 	seq, br := seqRead(first.Namespace), newBlockReads(bs...)
 	rev, err := s.run(ctx, TxBlock, append([]Read{seq}, br.reads()...), func(tx Tx, rev uint64) error {
-		if err := checkSeq(seq, first.Info.MinSeq); err != nil {
-			return err
-		}
 		if err := insertActiveBlocks(ctx, tx, rev, bs, br, out); err != nil {
 			return err
 		}
