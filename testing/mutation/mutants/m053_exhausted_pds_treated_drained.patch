mutant: m053_exhausted_pds_treated_drained
target: internal/ingest/backfill/store.go
failure-mode: |
  The bootstrap roster projection (bootstrapHostCursor) reports an
  exhausted PDS as drained. Future process runs then
  skip that host permanently instead of retrying it after external recovery,
  leaving every repo on the host absent while the fleet reports completion.
expected-detection: |
  The pdsbackfill tier's TestRun_MultiPDSFaultIsolationAndExhaustion creates a
  mixed durable roster, consumes the permanent-failure schedule, and runs the
  fleet again. It requires the formerly exhausted host to drain and all repos
  to converge; this mutant leaves the host skipped and the repo count short.
expected-tier: pdsbackfill
tiers: pdsbackfill

diff --git a/internal/ingest/backfill/store.go b/internal/ingest/backfill/store.go
--- a/internal/ingest/backfill/store.go
+++ b/internal/ingest/backfill/store.go
@@ -1307,7 +1307,8 @@
 // from the last checkpoint, and skip only a host a prior run fully
 // enumerated.
 func bootstrapHostCursor(host *PDSHost) atmosbackfill.HostCursorState {
-	return atmosbackfill.HostCursorState{Cursor: host.ListReposCursor, Drained: host.Enumerated}
+	drained := host.Enumerated || host.State == string(atmosbackfill.HostStateExhausted)
+	return atmosbackfill.HostCursorState{Cursor: host.ListReposCursor, Drained: drained}
 }
 
