mutant: m068_reference_check_skipped
target: internal/catalog/scripts.go
failure-mode: |
  resolve skips the design §7.4 reference check, so a hot batch, fold,
  direct block commit, seal, or publish can point at an object row that is
  not available (GC claimed it, or its upload never finished). Readers then
  fetch a missing object.
expected-detection: |
  Stage 2 has no GC, and pending uploads are marked available in the same
  transaction, so the layer 3 oracle never commits a missing reference.
  TestScripts_MissingReference and TestScripts_DirectBlockMissingReference
  require SourceRef corruption for each script.
expected-tier: disagg
tiers: disagg

diff --git a/internal/catalog/scripts.go b/internal/catalog/scripts.go
--- a/internal/catalog/scripts.go
+++ b/internal/catalog/scripts.go
@@ -303,9 +303,6 @@
 			missing = append(missing, id)
 		}
 	}
-	if len(missing) > 0 {
-		return nil, Corruptf(SourceRef, "objects %v are not available", missing)
-	}
 	return ids, tx.ClearUnreferenced(ctx, ids)
 }
 
